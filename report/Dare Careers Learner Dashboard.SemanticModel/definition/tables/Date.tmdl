	column Weekday
		lineageTag: abaa94c7-561e-4610-937d-913b5d443a93
		summarizeBy: none
		isNameInferred
		sourceColumn: [Weekday]

		annotation SummarizationSetBy = Automatic

	partition Date = calculated
		mode: import
		source =
				
				VAR MinD = MIN ( Attendance[Date] )
				VAR MaxD = MAX ( Attendance[Date] )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( DATE ( YEAR ( MinD ), MONTH ( MinD ), 1 ), EOMONTH ( MaxD, 0 ) ),
				    "Year", YEAR ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMMM" ),
				    "Month Year", FORMAT ( [Date], "MMM yyyy" ),
				    "Year Month Sort", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "Weekday", FORMAT ( [Date], "ddd" )
				)

	annotation PBI_Id = 4c8bdf94b2434811b84fd5bd3a2bdb1d

